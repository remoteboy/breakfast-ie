---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PlaceRow from '../../components/PlaceRow.astro';
import SearchBox from '../../components/SearchBox.astro';
import places from '../../data/places';
import {
  getPlaceDiscovery,
  type DiscoveryFilter,
} from '../../lib/discovery';

const dublinPlaces = places.filter(
  (place) => place.location.city === 'Dublin',
);

const discoveryBySlug = new Map(
  dublinPlaces.map((place) => [place.slug, getPlaceDiscovery(place)]),
);

const filterDefinitions = [
  ['full-irish', 'Full Irish'],
  ['under-15', 'Under €15'],
  ['early', 'Early'],
  ['all-day', 'All day'],
  ['vegetarian', 'Vegetarian'],
  ['vegan', 'Vegan'],
  ['gluten-free', 'GF option'],
  ['drink-included', 'Drink included'],
  ['menu', 'Verified menu'],
] as const satisfies readonly (readonly [DiscoveryFilter, string])[];

const filterCounts = new Map(
  filterDefinitions.map(([filter]) => [
    filter,
    dublinPlaces.filter((place) => discoveryBySlug.get(place.slug)?.filters.includes(filter)).length,
  ]),
);

const menuPlaceCount = dublinPlaces.filter(
  (place) => discoveryBySlug.get(place.slug)?.menuAvailable,
).length;
const menuItemCount = dublinPlaces.reduce(
  (total, place) => total + (discoveryBySlug.get(place.slug)?.menuItemCount ?? 0),
  0,
);
---

<BaseLayout
  title="Breakfast in Dublin — breakfast.ie"
  description="Find breakfast in Dublin by Full Irish, price, serving time, dietary options and what is actually on the breakfast menu."
>
  <div class="city-page">
    <header class="city-header">
      <p class="eyebrow">Ireland</p>
      <h1>Breakfast in Dublin</h1>
      <p class="intro">
        Good places for breakfast in Dublin, with the details that actually matter.
      </p>
      <p class="dataset-note">
        {menuPlaceCount} verified menus · {menuItemCount} accepted breakfast items
      </p>

      <div class="city-search">
        <SearchBox places={dublinPlaces} label="Search Dublin" compact />
      </div>
    </header>

    <section class="controls" aria-label="Breakfast filters">
      <div class="result-bar">
        <div class="result-copy" aria-live="polite">
          <strong data-result-count>{dublinPlaces.length} places</strong>
          <span class="query-label" data-query-label hidden></span>
          <span class="near-label" data-near-label hidden>· nearest first</span>
        </div>

        <div class="result-actions">
          <label class="sort-control">
            <span>Sort</span>
            <select data-sort>
              <option value="default">Featured</option>
              <option value="price">Lowest menu price</option>
              <option value="choice">Most menu choice</option>
              <option value="name">Name</option>
            </select>
          </label>

          <button class="reset" type="button" data-reset disabled>
            Reset
          </button>
        </div>
      </div>

      <div class="filter-strip">
        <span class="filter-label">Filter</span>
        <div class="filters">
          {
            filterDefinitions.map(([value, label]) => (
              <button type="button" data-filter={value} aria-pressed="false">
                <span>{label}</span>
                <small data-filter-count>{filterCounts.get(value) ?? 0}</small>
              </button>
            ))
          }
        </div>
      </div>
    </section>

    <section class="places" aria-label="Breakfast places in Dublin" data-places-container>
      {dublinPlaces.map((place, index) => <PlaceRow place={place} filterable order={index} />)}

      <div class="empty-state" data-empty-state hidden>
        <h2>No matches.</h2>
        <p>Try removing a filter or searching for something broader.</p>
      </div>
    </section>
  </div>

  <script>
    const filterButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];
    const resetButton = document.querySelector<HTMLButtonElement>('[data-reset]');
    const sortSelect = document.querySelector<HTMLSelectElement>('[data-sort]');
    const placeRows = [...document.querySelectorAll<HTMLElement>('[data-place]')];
    const placesContainer = document.querySelector<HTMLElement>('[data-places-container]');
    const count = document.querySelector<HTMLElement>('[data-result-count]');
    const queryLabel = document.querySelector<HTMLElement>('[data-query-label]');
    const nearLabel = document.querySelector<HTMLElement>('[data-near-label]');
    const emptyState = document.querySelector<HTMLElement>('[data-empty-state]');

    const normalise = (value: string) =>
      value
        .toLowerCase()
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .trim();

    const params = new URLSearchParams(window.location.search);
    const activeFilters = new Set(params.getAll('filter'));
    const rawQuery = params.get('q') || '';
    const query = normalise(rawQuery);
    const nearMode = params.get('near') === '1';
    const userLat = Number(params.get('lat'));
    const userLng = Number(params.get('lng'));
    const hasUserLocation = nearMode && Number.isFinite(userLat) && Number.isFinite(userLng);
    const requestedSort = params.get('sort') || 'default';
    let activeSort = hasUserLocation && requestedSort === 'default' ? 'nearest' : requestedSort;

    const toRadians = (value: number) => (value * Math.PI) / 180;

    const distanceKm = (lat1: number, lng1: number, lat2: number, lng2: number) => {
      const earthRadiusKm = 6371;
      const dLat = toRadians(lat2 - lat1);
      const dLng = toRadians(lng2 - lng1);
      const a =
        Math.sin(dLat / 2) ** 2 +
        Math.cos(toRadians(lat1)) *
          Math.cos(toRadians(lat2)) *
          Math.sin(dLng / 2) ** 2;

      return 2 * earthRadiusKm * Math.asin(Math.sqrt(a));
    };

    const formatDistance = (km: number) => {
      if (km < 1) return `${Math.max(50, Math.round((km * 1000) / 50) * 50)} m away`;
      if (km < 10) return `${km.toFixed(1)} km away`;
      return `${Math.round(km)} km away`;
    };

    const numericData = (row: HTMLElement, key: 'order' | 'priceFrom' | 'menuCount') => {
      const value = Number(row.dataset[key]);
      return Number.isFinite(value) ? value : null;
    };

    const rowDistance = (row: HTMLElement) => {
      if (!hasUserLocation) return Number.POSITIVE_INFINITY;

      const lat = Number(row.dataset.lat);
      const lng = Number(row.dataset.lng);
      if (!Number.isFinite(lat) || !Number.isFinite(lng)) return Number.POSITIVE_INFINITY;

      return distanceKm(userLat, userLng, lat, lng);
    };

    const rowMatches = (row: HTMLElement, filters: Set<string>) => {
      const values = new Set((row.dataset.filters || '').split(' ').filter(Boolean));
      const searchText = normalise(row.dataset.search || '');
      const matchesFilters = [...filters].every((filter) => values.has(filter));
      const matchesQuery = !query || searchText.includes(query);
      return matchesFilters && matchesQuery;
    };

    if (queryLabel && rawQuery) {
      queryLabel.textContent = `for “${rawQuery}”`;
      queryLabel.hidden = false;
    }

    if (sortSelect && hasUserLocation) {
      const nearest = document.createElement('option');
      nearest.value = 'nearest';
      nearest.textContent = 'Nearest';
      sortSelect.prepend(nearest);
    }

    if (sortSelect) {
      const validSort = [...sortSelect.options].some((option) => option.value === activeSort);
      if (!validSort) activeSort = hasUserLocation ? 'nearest' : 'default';
      sortSelect.value = activeSort;
    }

    const syncUrl = () => {
      const next = new URL(window.location.href);
      next.searchParams.delete('filter');

      activeFilters.forEach((filter) => next.searchParams.append('filter', filter));

      if (activeSort === 'default' || (activeSort === 'nearest' && hasUserLocation)) {
        next.searchParams.delete('sort');
      } else {
        next.searchParams.set('sort', activeSort);
      }

      window.history.replaceState({}, '', next);
    };

    const sortRows = () => {
      if (!placesContainer || !emptyState) return;

      const sorted = placeRows.slice().sort((a, b) => {
        if (activeSort === 'nearest') {
          return rowDistance(a) - rowDistance(b);
        }

        if (activeSort === 'price') {
          return (
            (numericData(a, 'priceFrom') ?? Number.POSITIVE_INFINITY) -
            (numericData(b, 'priceFrom') ?? Number.POSITIVE_INFINITY)
          );
        }

        if (activeSort === 'choice') {
          return (
            (numericData(b, 'menuCount') ?? 0) -
            (numericData(a, 'menuCount') ?? 0)
          );
        }

        if (activeSort === 'name') {
          return (a.dataset.name || '').localeCompare(b.dataset.name || '', 'en-IE');
        }

        return (numericData(a, 'order') ?? 0) - (numericData(b, 'order') ?? 0);
      });

      sorted.forEach((row) => placesContainer.insertBefore(row, emptyState));
    };

    const updateDistances = () => {
      placeRows.forEach((row) => {
        const distance = row.querySelector<HTMLElement>('[data-distance]');
        if (!distance) return;

        const km = rowDistance(row);
        if (!hasUserLocation || !Number.isFinite(km)) {
          distance.hidden = true;
          distance.textContent = '';
          return;
        }

        distance.textContent = formatDistance(km);
        distance.hidden = false;
      });
    };

    const updateFilterCounts = () => {
      filterButtons.forEach((button) => {
        const filter = button.dataset.filter;
        const countNode = button.querySelector<HTMLElement>('[data-filter-count]');
        if (!filter || !countNode) return;

        const candidateFilters = new Set(activeFilters);
        if (candidateFilters.has(filter)) candidateFilters.delete(filter);
        else candidateFilters.add(filter);

        const candidateCount = placeRows.filter((row) => rowMatches(row, candidateFilters)).length;
        countNode.textContent = String(candidateCount);
        button.disabled = !activeFilters.has(filter) && candidateCount === 0;
      });
    };

    const applyFilters = () => {
      let visibleCount = 0;

      placeRows.forEach((row) => {
        const visible = rowMatches(row, activeFilters);

        // Use an explicit inline display value. This avoids the row's grid CSS
        // overriding the browser's default [hidden] styling.
        row.style.display = visible ? '' : 'none';
        if (visible) visibleCount += 1;
      });

      filterButtons.forEach((button) => {
        const filter = button.dataset.filter;
        button.setAttribute('aria-pressed', String(Boolean(filter && activeFilters.has(filter))));
      });

      if (count) count.textContent = `${visibleCount} ${visibleCount === 1 ? 'place' : 'places'}`;
      if (emptyState) emptyState.hidden = visibleCount !== 0;
      if (resetButton) {
        resetButton.disabled =
          activeFilters.size === 0 && !query && !hasUserLocation && activeSort === 'default';
      }

      if (nearLabel) nearLabel.hidden = activeSort !== 'nearest';
      updateFilterCounts();
    };

    filterButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const filter = button.dataset.filter;
        if (!filter) return;

        if (activeFilters.has(filter)) activeFilters.delete(filter);
        else activeFilters.add(filter);

        syncUrl();
        applyFilters();
      });
    });

    sortSelect?.addEventListener('change', () => {
      activeSort = sortSelect.value;
      sortRows();
      syncUrl();
      applyFilters();
    });

    resetButton?.addEventListener('click', () => {
      window.location.assign('/dublin/');
    });

    sortRows();
    updateDistances();
    applyFilters();
  </script>
</BaseLayout>

<style>
  .city-page {
    padding-top: 72px;
  }

  .city-header {
    max-width: 900px;
    padding-bottom: 72px;
  }

  .eyebrow {
    margin: 0 0 16px;
    color: #555;
  }

  h1 {
    margin: 0;
    font-size: clamp(3.5rem, 9vw, 8rem);
    line-height: 0.9;
    letter-spacing: -0.065em;
  }

  .intro {
    max-width: 620px;
    margin: 32px 0 0;
    font-size: clamp(1.2rem, 2vw, 1.6rem);
    line-height: 1.4;
  }

  .dataset-note {
    margin: 12px 0 0;
    color: #666;
    font-size: 0.9rem;
  }

  .city-search {
    max-width: 760px;
    margin-top: 48px;
  }

  .controls {
    border-top: 1px solid #111;
    border-bottom: 1px solid #111;
  }

  .result-bar {
    display: flex;
    min-height: 58px;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    border-bottom: 1px solid #ddd;
  }

  .result-copy {
    display: flex;
    flex-wrap: wrap;
    gap: 0 6px;
  }

  .query-label,
  .near-label {
    color: #666;
  }

  .result-actions {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .sort-control {
    display: flex;
    align-items: center;
    gap: 8px;
    color: #666;
    font-size: 0.85rem;
  }

  .sort-control select {
    max-width: 180px;
    padding: 7px 28px 7px 9px;
    border: 1px solid #bbb;
    border-radius: 0;
    background: #fff;
    color: #111;
    font: inherit;
  }

  .reset {
    padding: 0;
    border: 0;
    background: transparent;
    color: #111;
    font: inherit;
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
  }

  .reset:disabled {
    visibility: hidden;
    pointer-events: none;
  }

  .filter-strip {
    display: flex;
    min-width: 0;
    align-items: center;
    gap: 16px;
    padding: 14px 0;
  }

  .filter-label {
    flex: 0 0 auto;
    color: #666;
    font-size: 0.85rem;
  }

  .filters {
    display: flex;
    min-width: 0;
    gap: 8px;
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    scrollbar-width: none;
  }

  .filters::-webkit-scrollbar {
    display: none;
  }

  .filters button {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: baseline;
    gap: 7px;
    padding: 8px 12px;
    border: 1px solid #111;
    border-radius: 0;
    background: #fff;
    color: #111;
    font: inherit;
    white-space: nowrap;
    cursor: pointer;
  }

  .filters button small {
    color: #777;
    font-size: 0.72rem;
  }

  .filters button[aria-pressed='true'] {
    background: #111;
    color: #fff;
  }

  .filters button[aria-pressed='true'] small {
    color: #ccc;
  }

  .filters button:disabled {
    border-color: #ccc;
    color: #aaa;
    cursor: not-allowed;
  }

  .places {
    padding-bottom: 72px;
  }

  .empty-state {
    padding: 64px 0;
    border-bottom: 1px solid #111;
  }

  .empty-state h2 {
    margin: 0;
    font-size: 2rem;
  }

  .empty-state p {
    margin-bottom: 0;
  }

  @media (max-width: 800px) {
    .city-page {
      padding-top: 48px;
    }

    .city-header {
      padding-bottom: 48px;
    }

    .city-search {
      margin-top: 36px;
    }

    .result-bar {
      align-items: flex-start;
      flex-direction: column;
      gap: 12px;
      padding: 14px 0;
    }

    .result-actions {
      width: 100%;
      justify-content: space-between;
    }
  }
</style>

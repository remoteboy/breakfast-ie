---
import BaseLayout from '../layouts/BaseLayout.astro';
import PlaceRow from '../components/PlaceRow.astro';
import SearchBox from '../components/SearchBox.astro';
import places from '../data/places';

const featuredPlaces = places
  .filter((place) => place.location.city === 'Dublin')
  .slice(0, 3);
---

<BaseLayout
  title="breakfast.ie"
  description="Find a good breakfast in Ireland."
>
  <section class="hero">
    <h1>Find a good breakfast.</h1>

    <SearchBox places={places} />

    <div class="quick-links" aria-label="Popular breakfast filters">
      <a href="/dublin/?filter=full-irish">Full Irish</a>
      <a href="/dublin/?filter=early">Early</a>
      <a href="/dublin/?filter=all-day">All day</a>
      <a href="/dublin/?filter=vegetarian">Vegetarian</a>
      <a href="/dublin/?filter=vegan">Vegan</a>
    </div>
  </section>

  <section class="places-section">
    <div class="section-heading">
      <div>
        <p class="section-kicker">Start here</p>
        <h2>Breakfast in Dublin</h2>
      </div>
      <a href="/dublin/">See all {places.filter((place) => place.location.city === 'Dublin').length}</a>
    </div>

    <div class="places">
      {featuredPlaces.map((place) => <PlaceRow place={place} />)}
    </div>
  </section>

  <section class="editorial">
    <h2>From the breakfast desk</h2>

    <article>
      <p class="kicker">The important questions</p>
      <h3>
        <a href="/guides/black-pudding-vs-white-pudding/">
          Black pudding vs white pudding
        </a>
      </h3>
      <p>
        Two puddings. One breakfast. An unnecessarily thorough examination.
      </p>
    </article>

    <article>
      <p class="kicker">A beginner's guide</p>
      <h3>
        <a href="/guides/full-irish-breakfast/">
          What exactly is a Full Irish?
        </a>
      </h3>
    </article>
  </section>
</BaseLayout>

<style>
  .hero {
    padding: 96px 0 80px;
    border-bottom: 1px solid #111;
  }

  h1 {
    max-width: 800px;
    margin: 0 0 56px;
    font-size: clamp(3rem, 8vw, 7rem);
    line-height: 0.9;
    letter-spacing: -0.06em;
  }

  .quick-links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 24px;
    margin-top: 28px;
  }

  .places-section,
  .editorial {
    padding: 64px 0;
    border-bottom: 1px solid #111;
  }

  .section-heading {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 32px;
  }

  .section-kicker {
    margin: 0 0 8px;
    color: #666;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  h2 {
    margin: 0;
    font-size: clamp(2rem, 4vw, 3.5rem);
    letter-spacing: -0.04em;
  }

  h3 {
    margin: 0;
    font-size: 1.5rem;
  }

  p {
    line-height: 1.5;
  }

  .places {
    border-top: 1px solid #111;
  }

  .editorial {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
  }

  .editorial > h2 {
    grid-column: 1 / -1;
  }

  .editorial article {
    padding-top: 24px;
    border-top: 1px solid #111;
  }

  .editorial h3 {
    font-size: clamp(1.75rem, 3vw, 2.75rem);
    letter-spacing: -0.035em;
  }

  .editorial h3 a {
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }

  .kicker {
    margin-top: 0;
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  @media (max-width: 760px) {
    .hero {
      padding: 64px 0 48px;
    }

    .section-heading {
      align-items: baseline;
    }

    .editorial {
      grid-template-columns: 1fr;
    }

    .editorial > h2 {
      grid-column: auto;
    }
  }
</style>
